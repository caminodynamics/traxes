############################################
# Rust build artifacts
############################################
/target/
**/*.rs.bk
*.exe
!docs/internal/legacy-release/*.exe

############################################
# Python cache
############################################
__pycache__/
*.pyc
*.pyo
*.pyd

############################################
# Logs & runtime outputs (NEVER publish)
############################################
logs/
*.log

############################################
# Benchmark / stress / evaluation artifacts
############################################
stress_suite/
benchmarks/
results/
execution_safety_bench*
contention*
bottleneck*
timing*
audit*
!src/audit_architecture.rs
performance*.log
performance*.out
temp_executed_*.txt
temp_benchmark_payload.json
benchmark_results.json

############################################
# Generated artifacts / dumps
############################################
artifacts/
coverage/
!src/coverage/
*.jsonl
*.dump
*.zip

############################################
# OS / editor noise
############################################
.vscode/
.idea/
.DS_Store

############################################
# Temporary scripts (keep only demo.bat)
############################################
fix-and-run*.bat
Traxas*.bat
*.tmp

############################################
# Optional local dev overrides
############################################
.env
.env.local

# Windsurf
.windsurfrules

# Analysis/working files
*.diff
*.md.bak
current_engine_state.md
build_errors.txt
demo_runtime.txt
runtime_measurement_output.txt

